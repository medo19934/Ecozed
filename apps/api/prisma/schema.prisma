// Latif Kids — core schema (Phase 1).
// Tenancy rule: every business table has `daycareId` and is listed in
// src/prisma/tenancy.ts (TENANT_MODELS). A test enforces this.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MANAGER
  STAFF
  PARENT
}

enum StaffType {
  TEACHER
  ASSISTANT
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  fullName      String
  email         String?   @unique
  phone         String?   @unique
  /// Google account subject ("sub"); set on first Google sign-in.
  googleId      String?   @unique
  locale        String    @default("ar")
  avatarUrl     String?
  isSuperAdmin  Boolean   @default(false)
  lastDaycareId String?   @db.Uuid
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  memberships   Membership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  guardianOf    ChildGuardian[]
}

/// A branch of the organisation (tenant boundary). Super admins see all branches.
model Daycare {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  nameEn          String?
  slug            String    @unique
  /// Storage key of the branch logo (served via GET /branches/current/logo).
  logoKey         String?
  phone           String?
  email           String?
  city            String?
  address         String?
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int       @default(150)
  currency        String    @default("SAR")
  timezone        String    @default("Asia/Riyadh")
  defaultLocale   String    @default("ar")
  useHijri        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  memberships Membership[]
  features    DaycareFeature[]
  auditLogs   AuditLog[]
  classrooms  Classroom[]
  children    Child[]
}

/// A user's role inside one daycare (tenant). Staff permission flags live here.
model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  daycareId     String           @db.Uuid
  userId        String           @db.Uuid
  role          Role
  staffType     StaffType?
  status        MembershipStatus @default(ACTIVE)
  /// StaffPermission flags (see @latif/shared). Managers implicitly have all.
  permissions   String[]         @default([])
  /// Staff profile (per branch).
  specialties   String[]         @default([])
  qualification String?
  address       String?
  joinDate      DateTime?        @db.Date
  /// HMAC of the personal 6-digit kiosk PIN (unique per branch). Shown once on generation.
  pinHash       String?
  /// Created by the admin-only TEST data button.
  isTest        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  daycare    Daycare           @relation(fields: [daycareId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classLinks ClassTeacher[]
  staffDays  StaffAttendance[]

  @@unique([userId, daycareId])
  @@unique([daycareId, pinHash])
  @@index([daycareId, role])
}

/// Per-daycare feature toggles (messages, QR attendance, in-app payment, geofenced staff attendance).
model DaycareFeature {
  id        String   @id @default(uuid()) @db.Uuid
  daycareId String   @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  daycare Daycare @relation(fields: [daycareId], references: [id], onDelete: Cascade)

  @@unique([daycareId, key])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  daycareId String?   @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Sensitive-action audit trail. daycareId is null for platform-level events.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  daycareId String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  daycare Daycare? @relation(fields: [daycareId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([daycareId, createdAt])
  @@index([entity, entityId])
}

enum Gender {
  MALE
  FEMALE
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum DocumentOwner {
  BRANCH
  STAFF
  CHILD
}

model Classroom {
  id           String    @id @default(uuid()) @db.Uuid
  daycareId    String    @db.Uuid
  name         String
  capacity     Int       @default(20)
  minAgeMonths Int?
  maxAgeMonths Int?
  color        String?
  isTest       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  daycare  Daycare        @relation(fields: [daycareId], references: [id], onDelete: Cascade)
  teachers ClassTeacher[]
  children Child[]

  @@index([daycareId])
}

/// Teacher ↔ class assignment. Teachers only see children of their classes.
model ClassTeacher {
  id           String @id @default(uuid()) @db.Uuid
  daycareId    String @db.Uuid
  classroomId  String @db.Uuid
  membershipId String @db.Uuid

  classroom  Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([classroomId, membershipId])
  @@index([daycareId])
}

model Child {
  id           String       @id @default(uuid()) @db.Uuid
  daycareId    String       @db.Uuid
  classroomId  String?      @db.Uuid
  fullName     String
  gender       Gender
  birthDate    DateTime     @db.Date
  photoKey     String?
  allergies    String?
  medicalNotes String?
  /// Authorised pickup people: [{ name, relationship, phone }]
  pickupPeople Json         @default("[]")
  status       RecordStatus @default(ACTIVE)
  isTest       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  daycare    Daycare           @relation(fields: [daycareId], references: [id], onDelete: Cascade)
  classroom  Classroom?        @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  guardians  ChildGuardian[]
  attendance ChildAttendance[]
  vacations  VacationRequest[]

  @@index([daycareId, status])
  @@index([daycareId, classroomId])
}

/// A guardian of a child. Linked to a parent account (userId) by email/phone.
model ChildGuardian {
  id           String   @id @default(uuid()) @db.Uuid
  daycareId    String   @db.Uuid
  childId      String   @db.Uuid
  userId       String?  @db.Uuid
  fullName     String
  relationship String
  phone        String?
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([daycareId])
  @@index([email])
  @@index([userId])
}

/// Private files (staff files now; child/branch documents later). Soft delete = bin.
model Document {
  id           String        @id @default(uuid()) @db.Uuid
  daycareId    String        @db.Uuid
  ownerType    DocumentOwner
  ownerId      String        @db.Uuid
  name         String
  category     String?
  storageKey   String
  mimeType     String
  size         Int
  expiresAt    DateTime?     @db.Date
  uploadedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  @@index([daycareId, ownerType, ownerId])
}

enum ChildAttendanceStatus {
  ATTENDED
  ABSENT
  VACATION
  DEPARTURE
}

enum AttendanceMethod {
  MANUAL
  QR
  PIN
  GEO
}

enum AttendanceDirection {
  IN
  OUT
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One row per child per day (branch-local date). No row = "no record".
model ChildAttendance {
  id           String                @id @default(uuid()) @db.Uuid
  daycareId    String                @db.Uuid
  childId      String                @db.Uuid
  date         DateTime              @db.Date
  status       ChildAttendanceStatus
  checkInAt    DateTime?
  checkOutAt   DateTime?
  droppedOffBy String?
  pickedUpBy   String?
  method       AttendanceMethod      @default(MANUAL)
  note         String?
  recordedById String?               @db.Uuid
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@index([daycareId, date])
}

/// One row per staff member per day.
model StaffAttendance {
  id           String           @id @default(uuid()) @db.Uuid
  daycareId    String           @db.Uuid
  membershipId String           @db.Uuid
  date         DateTime         @db.Date
  checkInAt    DateTime
  checkOutAt   DateTime?
  method       AttendanceMethod
  distanceM    Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
  @@index([daycareId, date])
}

/// Append-only log of every check-in/out (who, direction, time, method).
model AttendanceEvent {
  id           String              @id @default(uuid()) @db.Uuid
  daycareId    String              @db.Uuid
  childId      String?             @db.Uuid
  membershipId String?             @db.Uuid
  direction    AttendanceDirection
  method       AttendanceMethod
  actorId      String?             @db.Uuid
  latitude     Float?
  longitude    Float?
  distanceM    Int?
  at           DateTime            @default(now())

  @@index([daycareId, at])
  @@index([membershipId, at])
  @@index([childId, at])
}

model VacationRequest {
  id            String         @id @default(uuid()) @db.Uuid
  daycareId     String         @db.Uuid
  childId       String         @db.Uuid
  requestedById String         @db.Uuid
  startDate     DateTime       @db.Date
  endDate       DateTime       @db.Date
  reason        String?
  status        VacationStatus @default(PENDING)
  reviewedById  String?        @db.Uuid
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime       @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([daycareId, status])
  @@index([childId, startDate])
}
