{
  "expo": {
    "name": "Latif Kids",
    "slug": "latif-kids",
    "scheme": "latifkids",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.latifkids.mobile",
      "infoPlist": {}
    },
    "android": {
      "package": "app.latifkids.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#3fa9f5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "ar",
      "themeColor": "#5b6db4",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Latif Kids uses the camera to scan the attendance QR code at the entrance.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Latif Kids checks that you are at the branch when you check in."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirm it's you before checking in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Latif Kids lets you send photos in messages.",
          "cameraPermission": "Latif Kids uses the camera to take photos for messages and to scan the attendance QR code."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Latif Kids records voice notes you send in messages."
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5539d8ea-a30e-4167-bb50-80aa4d3eab86"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/5539d8ea-a30e-4167-bb50-80aa4d3eab86"
    },
    "icon": "./assets/icon.png",
    "owner": "med1999",
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
