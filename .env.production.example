# Copy to .env.production and fill in. Never commit the filled file.
DOMAIN=app.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_ACCESS_SECRET=change-me-long-random-1
JWT_REFRESH_SECRET=change-me-long-random-2
# Google OAuth client IDs (web, iOS, Android), comma-separated
GOOGLE_CLIENT_IDS=
# The web client ID again, for the browser sign-in button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Your Google email(s) → super admin on first sign-in
SUPER_ADMIN_EMAILS=
