# --- API (apps/api) ---
NODE_ENV=development
DATABASE_URL="postgresql://latif:latif@localhost:5432/latif_kids?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
OTP_SECRET="change-me-otp"
# Echo OTP codes in API responses (dev only; must be false in production)
OTP_DEV_ECHO=true
CORS_ORIGINS="http://localhost:3000"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="latif"
S3_SECRET_KEY="latif-secret"
S3_BUCKET="latif-kids"
LLM_PROVIDER="mock"
LLM_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SMTP_URL=""

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
