# --- API (apps/api) ---
NODE_ENV=development
DATABASE_URL="postgresql://latif:latif@localhost:5432/latif_kids?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
# Google sign-in: OAuth client IDs (web, iOS, Android) accepted as ID-token audience
GOOGLE_CLIENT_IDS=""
# Emails that become super admin (all branches) on first Google sign-in
SUPER_ADMIN_EMAILS=""
# Local dev only: email sign-in without Google (POST /auth/dev-login). Never true in production.
AUTH_DEV_LOGIN=false
# WhatsApp agent (Meta WhatsApp Cloud API). Leave empty to disable. WHATSAPP_SIMULATOR=true only for local testing.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SIMULATOR=false
# Optional: voice notes to text (ElevenLabs speech-to-text).
ELEVENLABS_API_KEY=
# Public demo: role cards + email/phone sign-in without verification, and demo data. INSECURE — demos only.
PUBLIC_DEMO=false
CORS_ORIGINS="http://localhost:3000"
# File storage: "local" (dev disk) or "s3" (MinIO/AWS). Files are private, served via the API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="latif"
S3_SECRET_KEY="latif-secret"
S3_BUCKET="latif-kids"
LLM_PROVIDER="mock"
LLM_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SMTP_URL=""

# --- Web (apps/web) — server-side only; copy to apps/web/.env.local if not using defaults ---
API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_AUTH_DEV_LOGIN=false
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
# "Get the app" page (/get-app): mobile web app (iPhone: Add to Home Screen) and Android APK links.
NEXT_PUBLIC_MOBILE_APP_URL="https://latif-kids-app.vercel.app"
NEXT_PUBLIC_ANDROID_APK_URL="https://github.com/medo19934/Ecozed/releases/latest"

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL="http://localhost:4000"
# Google OAuth client IDs for the mobile app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_AUTH_DEV_LOGIN=false
